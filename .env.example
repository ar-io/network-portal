# Copy to .env.local (devnet) or .env.localnet and fill in real values.
# Both are gitignored — never commit a file containing a provider auth token.
#
# A QuickNode URL embeds an auth token in its path. That token is inlined into
# the production bundle by Vite and is therefore readable by anyone who loads
# the app; keeping it out of git prevents source leakage, not distribution
# leakage. Protect the endpoint at QuickNode instead: use a dedicated token per
# app, restrict it with a Referrer allowlist, and set per-method rate limits.

# Solana RPC endpoint. Falls back to the public (rate-limited) RPC when unset.
VITE_SOLANA_RPC_URL=https://<your-endpoint>.solana-devnet.quiknode.pro/<token>/

# Mainnet endpoint, used by the network switcher in Settings.
VITE_SOLANA_MAINNET_RPC_URL=https://<your-endpoint>.solana-mainnet.quiknode.pro/<token>/

# ar.io Solana program IDs. Omit to use the SDK defaults for the network tier
# inferred from the RPC URL (devnet/mainnet/localnet).
VITE_ARIO_CORE_PROGRAM_ID=
VITE_ARIO_GAR_PROGRAM_ID=
VITE_ARIO_ARNS_PROGRAM_ID=
VITE_ARIO_ANT_PROGRAM_ID=
