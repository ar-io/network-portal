# Copy to .env.local (devnet) or .env.localnet and fill in real values.
# Both are gitignored — never commit a file containing a provider auth token.
#
# A QuickNode URL embeds an auth token in its path. That token is inlined into
# the production bundle by Vite and is therefore readable by anyone who loads
# the app; keeping it out of git prevents source leakage, not distribution
# leakage. Protect the endpoint at QuickNode instead: use a dedicated token per
# app, restrict it with a Referrer allowlist, and set per-method rate limits.

# Solana RPC endpoint. Falls back to the public (rate-limited) RPC when unset.
VITE_SOLANA_RPC_URL=https://<your-endpoint>.solana-devnet.quiknode.pro/<token>/

# Mainnet endpoint, used by the network switcher in Settings.
VITE_SOLANA_MAINNET_RPC_URL=https://<your-endpoint>.solana-mainnet.quiknode.pro/<token>/

# Optional second endpoint to fail over to when the primary is unhealthy.
# Leave unset unless you have one: this used to default to the public Solana RPC,
# and when the primary went down the app pushed 100% of its traffic — including
# whole-program scans — there at a flat 10 req/s that no amount of 429s slowed.
# Only point this at an endpoint you are entitled to saturate. With it unset the
# app surfaces an error and the user can switch endpoints in Settings.
VITE_SOLANA_FALLBACK_RPC_URL=

# ar.io Solana program IDs. Omit to use the SDK defaults for the network tier
# inferred from the RPC URL (devnet/mainnet/localnet).
VITE_ARIO_CORE_PROGRAM_ID=
VITE_ARIO_GAR_PROGRAM_ID=
VITE_ARIO_ARNS_PROGRAM_ID=
VITE_ARIO_ANT_PROGRAM_ID=

# Portal snapshot API, e.g. https://network.services.ar.io
#
# Serves the whole-program scans (gateways, vaults, balances, delegations) as
# static JSON so every visitor does not run them against RPC. Leave unset to
# read everything directly from RPC, which is also the automatic fallback
# whenever the API is unreachable, stale, or publishing a different network.
# It hosts public JSON and carries no credential.
VITE_PORTAL_API_URL=

# Presets offered in Settings so a user can flip between the published
# endpoints, or supply their own. Both default to the public hosts when unset;
# they are only applied by an explicit choice, so leaving VITE_PORTAL_API_URL
# empty still ships with the snapshot reads off.
VITE_PORTAL_MAINNET_API_URL=
VITE_PORTAL_DEVNET_API_URL=
